<!DOCTYPE html>
<html lang="uk">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Бібліотека технічної літератури{% endblock %} · Серверні веб-технології</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="top">
            <a class="brand" href="{{ path('site_home') }}">📚 Tech Library</a>
            <nav>
                <a href="{{ path('api_books') }}">JSON API</a>
                <a href="{{ path('admin') }}">Адмінка</a>
            </nav>
        </header>

        <main class="page">
            {% block body %}{% endblock %}
        </main>

        <footer class="foot">Серверні веб-технології · Symfony + Doctrine + Twig · {{ 'now'|date('Y') }}</footer>
    </body>
</html>